    "@types/express": "^4.17.21",
    "@types/node": "^22.13.10",
    "concurrently": "^9.1.2",
    "marked": "^15.0.7",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^6.2.2"
  }
